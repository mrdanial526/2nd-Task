# ==============================================================================
# AeroGrid Backend API - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost
API_PREFIX=/api/v1

# Security & Authentication (Replace with a strong secret in production)
JWT_SECRET=aerogrid_super_secret_jwt_key_2026
JWT_EXPIRES_IN=86400

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
